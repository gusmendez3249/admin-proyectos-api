# Copiar a .env y cambiar los valores. El archivo .env NO se sube al repositorio.
DB_USERNAME=gestor
DB_PASSWORD=cambia-esta-contrasena
GRAFANA_ADMIN_PASSWORD=cambia-esta-contrasena-tambien
APP_VERSION=latest
API_PORT=8081
FRONT_PORT=8082
# Aplicacion + monitoreo (Prometheus, Alertmanager, Grafana, Loki, Alloy, node-exporter, cAdvisor).
# Para levantar solo la aplicacion, dejar COMPOSE_FILE=docker-compose.yml
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:docker-compose.monitoreo.yml
# Para construir el front desde la copia local en lugar de GitHub:
# FRONT_CONTEXT=../../Ejercicio5Cliente
