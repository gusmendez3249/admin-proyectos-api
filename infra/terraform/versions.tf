terraform {
  required_version = ">= 1.6"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
    http = {
      source  = "hashicorp/http"
      version = "~> 3.4"
    }
    local = {
      source  = "hashicorp/local"
      version = "~> 2.5"
    }
  }
}

# La autenticacion se toma de la sesion de Azure CLI (az login): no hay llaves en el codigo.
provider "azurerm" {
  features {}
  subscription_id = var.subscription_id
}
